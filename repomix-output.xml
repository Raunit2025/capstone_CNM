    <script>
        const API_BASE = "http://localhost:30000/api";
        const USER_ID = "test_user_123";

        function setCategoryPill(category, pillElement) {
            document.querySelectorAll('.category-pill').forEach(el => {
                el.classList.remove('bg-rose-500', 'text-white', 'shadow-sm');
                el.classList.add('bg-slate-800', 'text-slate-300', 'hover:bg-slate-700', 'border', 'border-slate-700/60');
            });

            pillElement.classList.remove('bg-slate-800', 'text-slate-300', 'hover:bg-slate-700', 'border', 'border-slate-700/60');
            pillElement.classList.add('bg-rose-500', 'text-white', 'shadow-sm');

            document.getElementById('filter-category').value = category;
            applyFilters();
        }

        function resetFiltersUI() {
            document.getElementById("filter-name").value = "";
            document.getElementById("filter-category").value = "";
            document.getElementById("filter-min").value = "";
            document.getElementById("filter-max").value = "";

            const firstPill = document.querySelector('.category-pill');
            if (firstPill) setCategoryPill('', firstPill);
            fetchCatalog();
        }

        async function fetchCatalog(queryString = "") {
            try {
                const response = await fetch(`${API_BASE}/cakes${queryString}`);
                const cakes = await response.json();

                const grid = document.getElementById("catalog-grid");

                if (!cakes || cakes.length === 0) {
                    grid.innerHTML = `
                        <div class="col-span-full text-center py-16 bg-slate-900/30 border border-slate-800/60 rounded-3xl">
                            <p class="text-slate-500 font-medium text-sm">No cakes found matching your filter options.</p>
                        </div>
                    `;
                    return;
                }

                const cakesWithRatings = await Promise.all(cakes.map(async (cake) => {
                    try {
                        const ratingRes = await fetch(`${API_BASE}/rating/${cake._id}`);
                        const ratingData = await ratingRes.json();
                        return {
                            ...cake,
                            averageRating: ratingData.averageRating || 0,
                            totalRating: ratingData.totalRating || 0
                        };
                    } catch (e) {
                        return { ...cake, averageRating: 0, totalRating: 0 };
                    }
                }));

                grid.innerHTML = cakesWithRatings
                    .map(
                        (cake) => `
            <div class="group bg-slate-900/90 border border-slate-800 hover:border-slate-700/80 rounded-2xl overflow-hidden flex flex-col transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-rose-950/10">
                <div class="relative overflow-hidden aspect-[16/10]">
                    <img src="${cake.imageReference}" alt="${cake.name}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent"></div>
