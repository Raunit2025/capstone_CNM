<!-- frontend/index.html -->
<!doctype html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cake Delight - Capstone</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100 font-sans text-gray-800">
    <!-- Navigation -->
    <nav class="bg-white shadow-md p-4 sticky top-0 z-10">
        <div class="max-w-6xl mx-auto flex justify-between items-center">
            <h1 class="text-2xl font-bold text-red-600">Cake Delight</h1>
            <button onclick="toggleBasket()"
                class="bg-red-500 text-white px-4 py-2 rounded-lg hover:bg-red-600 transition">
                Basket (<span id="basket-count">0</span>)
            </button>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="max-w-6xl mx-auto p-6">
        <!-- Filters Section -->
        <div class="mb-8 bg-white p-4 rounded-lg shadow-sm flex flex-wrap gap-4 items-center">
            <input type="text" id="filter-name" placeholder="Search by name..." class="border p-2 rounded flex-grow" />
            <select id="filter-category" class="border p-2 rounded">
                <option value="">All Categories</option>
                <option value="Chocolate">Chocolate</option>
                <option value="Fruit">Fruit</option>
                <option value="Classic">Classic</option>
                <option value="Specialty">Specialty</option>
                <option value="Vegan">Vegan</option>
            </select>
            <input type="number" id="filter-min" placeholder="Min ₹" class="border p-2 rounded w-24" />
            <input type="number" id="filter-max" placeholder="Max ₹" class="border p-2 rounded w-24" />
            <button onclick="applyFilters()"
                class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 transition">
                Filter
            </button>
            <button onclick="resetFilters()" class="text-gray-500 hover:text-gray-800 underline px-2">
                Reset
            </button>
        </div>

        <h2 class="text-xl font-semibold mb-6">Our Catalog</h2>
        <div id="catalog-grid" class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- Cakes will be injected here via JS -->
        </div>
    </main>

    <!-- Basket Modal -->
    <div id="basket-modal" class="fixed inset-0 bg-black bg-opacity-50 hidden justify-center items-center z-50">
        <div class="bg-white rounded-lg shadow-xl w-full max-w-md p-6">
            <h2 class="text-xl font-bold mb-4">Your Basket</h2>
            <div id="basket-items" class="space-y-4 max-h-64 overflow-y-auto mb-4">
                <!-- Basket items injected here -->
            </div>
            <div class="border-t pt-4 flex justify-between font-bold text-lg">
                <span>Total:</span>
                <span>₹<span id="basket-total">0.00</span></span>
            </div>
            <div class="mt-6 flex justify-end space-x-3">
                <button onclick="toggleBasket()" class="px-4 py-2 text-gray-600 hover:text-gray-800">
                    Close
                </button>
                <button onclick="checkout()" class="bg-green-500 text-white px-4 py-2 rounded-lg hover:bg-green-600">
                    Checkout
                </button>
            </div>
        </div>
    </div>

    <!-- Checkout Modal -->
    <div id="checkout-modal" class="fixed inset-0 bg-black bg-opacity-50 hidden justify-center items-center z-50">
        <div class="bg-white rounded-lg shadow-xl w-full max-w-md p-6">
            <h2 class="text-xl font-bold mb-4">Complete Checkout</h2>
            <form id="checkout-form" onsubmit="submitCheckout(event)">
                <div class="mb-4">
                    <label class="block text-sm font-medium mb-1">Full Name</label>
                    <input type="text" id="checkout-name" required
                        class="w-full border p-2 rounded focus:outline-blue-500" />
                </div>
                <div class="mb-6">
                    <label class="block text-sm font-medium mb-1">Email Address</label>
                    <input type="email" id="checkout-email" required
                        class="w-full border p-2 rounded focus:outline-blue-500" />
                </div>
                <div class="flex justify-end space-x-3">
                    <button type="button" onclick="toggleCheckoutModal()"
                        class="px-4 py-2 text-gray-600 hover:text-gray-800">
                        Cancel
                    </button>
                    <button type="submit" class="bg-green-500 text-white px-4 py-2 rounded-lg hover:bg-green-600">
                        Confirm Order
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Reviews Modal -->
    <div id="reviews-modal" class="fixed inset-0 bg-black bg-opacity-50 hidden justify-center items-center z-50">
        <div class="bg-white rounded-lg shadow-xl w-full max-w-lg p-6 max-h-[90vh] flex flex-col">
            <div class="flex justify-between items-center mb-4">
                <h2 class="text-xl font-bold" id="review-cake-title">Cake Reviews</h2>
                <button onclick="toggleReviewsModal()" class="text-gray-500 hover:text-gray-800 font-bold text-2xl">
                    &times;
                </button>
            </div>

            <!-- List of Reviews -->
            <div id="reviews-list" class="space-y-4 mb-6 overflow-y-auto flex-grow border-b pb-4">
                <!-- Reviews injected here -->
            </div>

            <!-- Submit Review Form -->
            <div class="pt-2">
                <h3 class="font-semibold mb-3">Leave a Review</h3>
                <form id="review-form" onsubmit="submitReview(event)">
                    <input type="hidden" id="review-cake-id" />
                    <div class="mb-2">
                        <input type="text" id="review-name" placeholder="Your Name" required
                            class="w-full border p-2 rounded text-sm focus:outline-blue-500" />
                    </div>
                    <div class="mb-2">
                        <select id="review-rating" required
                            class="w-full border p-2 rounded text-sm focus:outline-blue-500">
                            <option value="5">5 - Excellent (⭐⭐⭐⭐⭐)</option>
                            <option value="4">4 - Good (⭐⭐⭐⭐)</option>
                            <option value="3">3 - Average (⭐⭐⭐)</option>
                            <option value="2">2 - Poor (⭐⭐)</option>
                            <option value="1">1 - Terrible (⭐)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <textarea id="review-text" placeholder="Tell us what you thought..."
                            class="w-full border p-2 rounded text-sm focus:outline-blue-500" rows="2"></textarea>
                    </div>
                    <button type="submit"
                        class="bg-yellow-500 text-white font-semibold px-4 py-2 rounded w-full hover:bg-yellow-600 transition">
                        Submit Review
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div id="toast-notification"
        class="fixed top-5 right-5 bg-green-600 text-white px-6 py-4 rounded-lg shadow-2xl transform transition-all duration-300 translate-x-full opacity-0 z-[100] flex items-center space-x-3">
        <svg class="w-6 h-6 text-white flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
        </svg>
        <div>
            <h4 class="font-bold text-lg">Order Confirmed!</h4>
            <p id="toast-message" class="text-sm mt-1">Receipt will be sent to your email.</p>
        </div>
        <button onclick="closeToast()"
            class="ml-4 text-white hover:text-gray-200 font-bold text-xl leading-none">&times;</button>
    </div>

    <script>
        const API_BASE = "http://localhost:30000/api";
        const USER_ID = "test_user_123";

        // 1. Fetch and Display Catalog with Filters
        async function fetchCatalog(queryString = "") {
            try {
                const response = await fetch(`${API_BASE}/cakes${queryString}`);
                const cakes = await response.json();

                const grid = document.getElementById("catalog-grid");

                if (cakes.length === 0) {
                    grid.innerHTML =
                        '<p class="col-span-full text-center text-gray-500">No cakes found matching your filters.</p>';
                    return;
                }

                grid.innerHTML = cakes
                    .map(
                        (cake) => `
            <div class="bg-white rounded-lg shadow-md overflow-hidden flex flex-col">
                <img src="${cake.imageReference}" alt="${cake.name}" class="w-full h-48 object-cover">
                <div class="p-4 flex-grow flex flex-col justify-between">
                    <div>
                        <h3 class="text-lg font-bold">${cake.name}</h3>
                        <p class="text-xs inline-block bg-gray-200 text-gray-700 px-2 py-1 rounded mt-1 mb-2">${cake.category}</p>
                        <p class="text-gray-700 text-sm mb-4">${cake.description}</p>
                    </div>
                    <div class="flex justify-between items-center mt-4 pt-2 border-t">
                        <span class="font-bold text-lg text-green-700">₹${cake.price}</span>
                        <div class="flex space-x-2">
                            <button onclick="openReviewsModal('${cake._id}', '${cake.name.replace(/'/g, "\\'")}')" 
                                    class="bg-gray-100 text-gray-700 px-3 py-1 rounded hover:bg-gray-200 transition text-sm">
                                ⭐ Reviews
                            </button>
                            <button onclick="addToBasket(event, '${cake._id}', '${cake.name.replace(/'/g, "\\'")}', ${cake.price})" 
                                    class="bg-blue-500 text-white px-3 py-1 rounded hover:bg-blue-600 transition shadow-sm text-sm">
                                Add
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        `
                    )
                    .join("");
            } catch (error) {
                console.error("Error fetching catalog:", error);
            }
        }
        // 2. Filter Handlers
        function applyFilters() {
            const name = document.getElementById("filter-name").value;
            const category = document.getElementById("filter-category").value;
            const minPrice = document.getElementById("filter-min").value;
            const maxPrice = document.getElementById("filter-max").value;

            const params = new URLSearchParams();
            if (name) params.append("name", name);
            if (category) params.append("category", category);
            if (minPrice) params.append("minPrice", minPrice);
            if (maxPrice) params.append("maxPrice", maxPrice);

            const queryString = params.toString() ? `?${params.toString()}` : "";
            fetchCatalog(queryString);
        }

        function resetFilters() {
            document.getElementById("filter-name").value = "";
            document.getElementById("filter-category").value = "";
            document.getElementById("filter-min").value = "";
            document.getElementById("filter-max").value = "";
            fetchCatalog();
        }

        // 3. Add to Basket
        async function addToBasket(event, cakeId, cakeName, price) {
            try {
                await fetch(`${API_BASE}/orders/basket/${USER_ID}`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ cakeId, cakeName, price, quantity: 1 }),
                });
                updateBasketUI();

                // Visual feedback using the passed event
                const btn = event.target;
                const originalText = btn.innerText;
                btn.innerText = "Added!";
                btn.classList.add("bg-green-500");
                setTimeout(() => {
                    btn.innerText = originalText;
                    btn.classList.remove("bg-green-500");
                }, 1000);
            } catch (error) {
                console.error("Error adding to basket:", error);
            }
        }
        // 4. Update Basket UI
        async function updateBasketUI() {
            try {
                const response = await fetch(`${API_BASE}/orders/basket/${USER_ID}`);
                const data = await response.json();

                document.getElementById("basket-count").innerText =
                    data.basket.length;
                document.getElementById("basket-total").innerText =
                    data.totalAmount.toFixed(2);

                const basketContainer = document.getElementById("basket-items");
                if (data.basket.length === 0) {
                    basketContainer.innerHTML =
                        '<p class="text-gray-500">Your basket is empty.</p>';
                    return;
                }

                basketContainer.innerHTML = data.basket
                    .map(
                        (item) => `
                    <div class="flex justify-between items-center border-b pb-2">
                        <div>
                            <p class="font-semibold">${item.cakeName}</p>
                            <p class="text-sm text-gray-500">Qty: ${item.quantity} x ₹${item.price}</p>
                        </div>
                        <p class="font-bold">₹${(item.quantity * item.price).toFixed(2)}</p>
                    </div>
                `,
                    )
                    .join("");
            } catch (error) {
                console.error("Error fetching basket:", error);
            }
        }

        // 5. Checkout
        function checkout() {
            toggleBasket(); // Close basket
            toggleCheckoutModal(); // Open custom form
        }

        function toggleCheckoutModal() {
            const modal = document.getElementById('checkout-modal');
            modal.classList.toggle('hidden');
            modal.classList.toggle('flex');
            document.getElementById('checkout-form').reset();
        }

        async function submitCheckout(event) {
            event.preventDefault();
            const name = document.getElementById('checkout-name').value;
            const email = document.getElementById('checkout-email').value;

            try {
                const response = await fetch(`${API_BASE}/orders/checkout/${USER_ID}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ customerName: name, customerEmail: email })
                });

                if (response.ok) {
                    toggleCheckoutModal(); // Close the modal
                    updateBasketUI(); // Clear basket in UI
                    showToast(email); // Show the new in-app notification!
                } else {
                    const err = await response.json();
                    alert(`Checkout failed: ${err.message}`);
                }
            } catch (error) {
                console.error('Error during checkout:', error);
            }
        }
        // --- REVIEWS LOGIC ---
        function toggleReviewsModal() {
            const modal = document.getElementById('reviews-modal');
            modal.classList.toggle('hidden');
            modal.classList.toggle('flex');
            document.getElementById('review-form').reset();
        }

        async function openReviewsModal(cakeId, cakeName) {
            document.getElementById('review-cake-title').innerText = `Reviews: ${cakeName}`;
            document.getElementById('review-cake-id').value = cakeId;
            const list = document.getElementById('reviews-list');
            list.innerHTML = '<p class="text-center text-gray-500 py-4">Loading reviews...</p>';

            toggleReviewsModal();

            try {
                const response = await fetch(`${API_BASE}/rating/${cakeId}`);
                const data = await response.json();

                if (data.totalRating === 0 || !data.review || data.review.length === 0) {
                    list.innerHTML = '<p class="text-center text-gray-500 py-4">No reviews yet. Be the first to review!</p>';
                    return;
                }

                list.innerHTML = data.review.map(r => `
                    <div class="bg-gray-50 p-3 rounded-lg border border-gray-200">
                        <div class="flex justify-between items-center mb-1">
                            <span class="font-bold text-sm text-gray-800">${r.userName}</span>
                            <span class="text-yellow-500 text-sm tracking-widest">${'★'.repeat(r.rating)}${'☆'.repeat(5 - r.rating)}</span>
                        </div>
                        <p class="text-gray-600 text-sm mt-1">${r.review || ''}</p>
                    </div>
                `).join('');
            } catch (error) {
                list.innerHTML = '<p class="text-red-500 py-4 text-center">Failed to load reviews.</p>';
            }
        }

        async function submitReview(event) {
            event.preventDefault();
            const cakeId = document.getElementById('review-cake-id').value;
            const userName = document.getElementById('review-name').value;
            const rating = document.getElementById('review-rating').value;
            const review = document.getElementById('review-text').value;

            try {
                const response = await fetch(`${API_BASE}/rating`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        cakeId,
                        userId: USER_ID,
                        userName,
                        rating: Number(rating),
                        review
                    })
                });

                if (response.ok) {
                    const btn = event.target.querySelector('button[type="submit"]');
                    btn.innerText = 'Submitted!';
                    btn.classList.add('bg-green-500');
                    setTimeout(() => {
                        toggleReviewsModal();
                        btn.innerText = 'Submit Review';
                        btn.classList.remove('bg-green-500');
                    }, 1000);
                }
            } catch (error) {
                console.error('Error submitting review:', error);
            }
        }
        // UI toggles
        function toggleBasket() {
            const modal = document.getElementById("basket-modal");
            modal.classList.toggle("hidden");
            modal.classList.toggle("flex");
            if (!modal.classList.contains("hidden")) {
                updateBasketUI();
            }
        }

        // --- TOAST NOTIFICATION LOGIC ---
        function showToast(email) {
            const toast = document.getElementById('toast-notification');
            const message = document.getElementById('toast-message');
            
            message.innerText = `Order details and receipt will be sent to ${email}`;
            
            // Slide in
            toast.classList.remove('translate-x-full', 'opacity-0');
            
            // Auto-hide after 5 seconds
            setTimeout(closeToast, 5000);
        }

        function closeToast() {
            const toast = document.getElementById('toast-notification');
            toast.classList.add('translate-x-full', 'opacity-0');
        }

        // Run on load
        fetchCatalog();
        updateBasketUI();
    </script>
</body>

</html>
