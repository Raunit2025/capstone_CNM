        function applyFilters() {
            const name = document.getElementById("filter-name").value;
            const category = document.getElementById("filter-category").value;
            const minPrice = document.getElementById("filter-min").value;
            const maxPrice = document.getElementById("filter-max").value;

            const params = new URLSearchParams();
            if (name) params.append("name", name);
            if (category) params.append("category", category);
            if (minPrice) params.append("minPrice", minPrice);
            if (maxPrice) params.append("maxPrice", maxPrice);

            const queryString = params.toString() ? `?${params.toString()}` : "";
            fetchCatalog(queryString);
        }

        function resetFilters() {
            resetFiltersUI();
        }

        async function addToBasket(event, cakeId, cakeName, price) {
            try {
                await fetch(`${API_BASE}/orders/basket/${USER_ID}`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ cakeId, cakeName, price, quantity: 1 }),
                });
                updateBasketUI();

                const btn = event.currentTarget;
                const originalContent = btn.innerHTML;
                btn.innerHTML = `✓ Added`;
                btn.classList.replace("bg-rose-600", "bg-emerald-500");

                setTimeout(() => {
                    btn.innerHTML = originalContent;
                    btn.classList.replace("bg-emerald-500", "bg-rose-600");
                }, 1000);
            } catch (error) {
                console.error("Error adding to basket:", error);
            }
        }

        async function updateBasketUI() {
            try {
                const response = await fetch(`${API_BASE}/orders/basket/${USER_ID}`);
                const data = await response.json();

                document.getElementById("basket-count").innerText = data.basket.length;
                document.getElementById("basket-total").innerText = data.totalAmount.toFixed(2);

                const basketContainer = document.getElementById("basket-items");
                if (data.basket.length === 0) {
                    basketContainer.innerHTML = '<p class="text-slate-500 text-xs text-center py-8">Your basket is empty.</p>';
                    return;
                }

                basketContainer.innerHTML = data.basket
                    .map(
                        (item) => `
                    <div class="flex justify-between items-center bg-slate-950/60 p-3 rounded-xl border border-slate-800 mb-3 group">
                        <div class="flex-grow">
                            <p class="font-semibold text-slate-200 text-xs">${item.cakeName}</p>
                            
                            <!-- Quantity Controls -->
                            <div class="flex items-center gap-3 mt-2">
                                <div class="flex items-center bg-slate-800 rounded-lg overflow-hidden border border-slate-700/60">
                                    <button onclick="updateQuantity('${item.cakeId}', '${item.cakeName.replace(/'/g, "\\'")}', ${item.price}, ${item.quantity}, -1)" 
                                        class="px-2.5 py-1 text-slate-400 hover:text-white hover:bg-slate-700 transition font-bold">-</button>
                                    <span class="text-[11px] font-bold text-slate-200 px-2 min-w-[24px] text-center">${item.quantity}</span>
                                    <button onclick="updateQuantity('${item.cakeId}', '${item.cakeName.replace(/'/g, "\\'")}', ${item.price}, ${item.quantity}, 1)" 
                                        class="px-2.5 py-1 text-slate-400 hover:text-white hover:bg-slate-700 transition font-bold">+</button>
                                </div>
                                <p class="text-[11px] text-slate-400">× ₹${item.price}</p>
                            </div>
                        </div>
                        
                        <div class="flex flex-col items-end gap-2 ml-4">
                            <!-- Trash Button -->
                            <button onclick="removeFromBasket('${item.cakeId}')" 
                                class="text-slate-600 hover:text-rose-500 transition-colors p-1" title="Remove from basket">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                </svg>
                            </button>
                            <!-- Line Total -->
                            <p class="font-bold text-emerald-400 text-sm">₹${(item.quantity * item.price).toFixed(2)}</p>
                        </div>
                    </div>
                `
                    ).join("");
            } catch (error) {
                console.error("Error fetching basket:", error);
            }
        }

        async function updateQuantity(cakeId, cakeName, price, currentQuantity, change) {
            const newQuantity = currentQuantity + change;

            // If dropping below 1, remove the item completely
            if (newQuantity <= 0) {
                await removeFromBasket(cakeId);
                return;
            }

            try {
                await fetch(`${API_BASE}/orders/basket/${USER_ID}`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ cakeId, cakeName, price, quantity: change }), // Backend adds this to current total
                });
                updateBasketUI();
            } catch (error) {
                console.error("Error updating quantity:", error);
            }
        }

        async function removeFromBasket(cakeId) {
            try {
                await fetch(`${API_BASE}/orders/basket/${USER_ID}/${cakeId}`, {
                    method: "DELETE"
                });
                updateBasketUI();
            } catch (error) {
                console.error("Error removing item:", error);
            }
        }
        function checkout() {
            toggleBasket();
            toggleCheckoutModal();
        }

        function toggleCheckoutModal() {
            const modal = document.getElementById('checkout-modal');
            modal.classList.toggle('hidden');
            modal.classList.toggle('flex');
            document.getElementById('checkout-form').reset();
        }

        async function submitCheckout(event) {
            event.preventDefault();
            const name = document.getElementById('checkout-name').value;
            const email = document.getElementById('checkout-email').value;

            try {
                const response = await fetch(`${API_BASE}/orders/checkout/${USER_ID}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ customerName: name, customerEmail: email })
                });

                if (response.ok) {
                    toggleCheckoutModal();
                    updateBasketUI();
                    showToast(email);
                } else {
                    const err = await response.json();
                    alert(`Checkout failed: ${err.message}`);
                }
            } catch (error) {
                console.error('Error during checkout:', error);
            }
        }

        function toggleReviewsModal() {
            const modal = document.getElementById('reviews-modal');
            modal.classList.toggle('hidden');
            modal.classList.toggle('flex');
            document.getElementById('review-form').reset();
        }

        async function openReviewsModal(cakeId, cakeName) {
            document.getElementById('review-cake-title').innerText = cakeName;
            document.getElementById('review-cake-id').value = cakeId;
            const list = document.getElementById('reviews-list');
            list.innerHTML = '<p class="text-center text-slate-500 py-6 text-xs">Loading reviews...</p>';

            toggleReviewsModal();

            try {
                const response = await fetch(`${API_BASE}/rating/${cakeId}`);
                const data = await response.json();

                if (data.totalRating === 0 || !data.review || data.review.length === 0) {
                    list.innerHTML = '<p class="text-center text-slate-500 py-6 text-xs">No reviews yet. Be the first to leave one!</p>';
                    return;
                }

                list.innerHTML = data.review.map(r => `
                    <div class="bg-slate-950/60 p-3 rounded-xl border border-slate-800">
                        <div class="flex justify-between items-center mb-1">
                            <span class="font-bold text-xs text-slate-300">${r.userName}</span>
                            <span class="text-amber-400 text-xs">${'★'.repeat(r.rating)}<span class="text-slate-700">${'★'.repeat(5 - r.rating)}</span></span>
                        </div>
                        <p class="text-slate-400 text-xs leading-relaxed">${r.review || ''}</p>
                    </div>
                `).join('');
            } catch (error) {
                list.innerHTML = '<p class="text-rose-400 py-6 text-center text-xs">Failed to load reviews.</p>';
            }
        }

        async function submitReview(event) {
            event.preventDefault();
            const cakeId = document.getElementById('review-cake-id').value;
            const userName = document.getElementById('review-name').value;
            const rating = document.getElementById('review-rating').value;
            const review = document.getElementById('review-text').value;

            try {
                const response = await fetch(`${API_BASE}/rating`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        cakeId,
                        userId: USER_ID,
                        userName,
                        rating: Number(rating),
                        review
                    })
                });

                if (response.ok) {
                    const btn = event.target.querySelector('button[type="submit"]');
                    btn.innerText = 'Submitted!';
                    btn.classList.replace('bg-amber-500', 'bg-emerald-500');

                    setTimeout(() => {
                        toggleReviewsModal();
                        fetchCatalog();
                        btn.innerText = 'Submit Review';
                        btn.classList.replace('bg-emerald-500', 'bg-amber-500');
                    }, 1000);
                }
            } catch (error) {
                console.error('Error submitting review:', error);
            }
        }

        function toggleBasket() {
            const modal = document.getElementById("basket-modal");
            modal.classList.toggle("hidden");
            modal.classList.toggle("flex");
            if (!modal.classList.contains("hidden")) {
                updateBasketUI();
            }
        }

        function showToast(email) {
            const toast = document.getElementById('toast-notification');
            const message = document.getElementById('toast-message');

            message.innerText = `Confirmation sent to ${email}`;
            toast.classList.remove('translate-y-32', 'opacity-0');

            setTimeout(closeToast, 5000);
        }

        function closeToast() {
            const toast = document.getElementById('toast-notification');
            toast.classList.add('translate-y-32', 'opacity-0');
        }

        fetchCatalog();
        updateBasketUI();
    </script>
</body>

</html>
